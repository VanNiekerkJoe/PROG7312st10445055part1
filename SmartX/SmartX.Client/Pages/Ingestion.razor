@page "/ingestion"
@using SmartX.Client.Components
@inject TelemetryApiClient Api
@inject TelemetryHubClient Hub
@implements IAsyncDisposable
<div class="dashboard">
    <header class="dashboard-header">
        <div class="brand"><span class="logo-mark">◈</span> Smart-X gateway</div>
        <nav class="pillar-pills">
            <a href="/ingestion" class="pill pill-active">Sensor ingestion</a>
            <span class="pill pill-disabled">Command stream</span>
            <span class="pill pill-disabled">Mesh topology</span>
        </nav>
        <button class="registration-toggle-btn" @onclick="() => _showRegistrationForm = !_showRegistrationForm">
            + Register sensor
        </button>
        @if (_seederRunning)
        {
            <button class="test-data-btn" @onclick="StopSeeder" style="color: var(--red); border-color: var(--red);" disabled="@_busy">
                ⏹ Stop seeder
            </button>
        }
        else
        {
            <button class="test-data-btn" @onclick="StartSeeder" style="color: var(--green); border-color: var(--green);" disabled="@_busy">
                ▶ Start seeder
            </button>
        }
        <button class="test-data-btn" @onclick="ClearAllDevices" style="color: var(--orange); border-color: var(--orange);" disabled="@_busy">
            🗑 Clear all devices
        </button>
        <button class="test-data-btn" @onclick="ReloadFromApi" style="color: var(--accent); border-color: var(--accent-dim);" disabled="@_busy">
            🔄 Reload from API
        </button>
    </header>
    <div class="metric-row">
        <MetricCard Label="Active sensors" Value="@_activeSensors.ToString()" />
        <MetricCard Label="Anomalies, 1h" Value="@_anomalyCount.ToString()" ValueClass="sev-anomalous-text" />
        <MetricCard Label="Disconnected" Value="@_disconnectedCount.ToString()" ValueClass="sev-disconnected-text" />
        <MetricCard Label="Throughput" Value="@($"{_throughputPerMinute}/min")" />
    </div>
    @if (_showRegistrationForm)
    {
        <DeviceRegistrationForm ApiClient="Api" 
                                OnClose="() => _showRegistrationForm = false" 
                                OnRegistered="OnDeviceRegistered" />
    }
    @if (_highlightZone is not null)
    {
        <div class="filter-chip">
            Filtered: @_highlightZone
            <span class="filter-clear" @onclick="() => _highlightZone = null">✕ clear</span>
        </div>
    }
    <div class="main-grid">
        <ZoneList Zones="_zoneSummaries" OnZoneSelected="OnZoneClicked" ActiveZone="_highlightZone" />
        <div class="panel constellation-panel">
            <p class="panel-title">Anomaly constellation</p>
            <ConstellationView @ref="_constellationView" 
                               Devices="_devices" 
                               OnDeviceSelected="OnDeviceSelected"
                               SelectedDeviceId="_selected?.DeviceId" 
                               HighlightZone="_highlightZone"
                               OnResetFilters="() => _highlightZone = null" />
        </div>
        <SensorDetailPanel Selected="_selected" ApiClient="Api" OnRemoveDevice="RemoveDevice" />
    </div>
    <AlertTimeline Events="_alertEvents" />
</div>

@code {
    // _statusByDevice is a client-side cache only. The registry it mirrors
    // lives on the server (SensorRegistry); every mutation below (register,
    // remove, clear) goes through the API first and only updates this cache
    // once the server has confirmed it, so a reload or SignalR reconnect can
    // never resurrect something the server has already forgotten.
    private readonly Dictionary<string, DeviceStatus> _statusByDevice = new();
    private readonly List<AlertTimeline.AlertEvent> _alertEvents = [];
    private const int MaxAlertEvents = 40;
    private List<DeviceStatus> _devices = [];
    private List<ZoneList.ZoneSummary> _zoneSummaries = [];
    private DeviceStatus? _selected;
    private string? _highlightZone;
    private bool _showRegistrationForm;
    private int _activeSensors;
    private int _anomalyCount;
    private int _disconnectedCount;
    private int _throughputPerMinute;
    private ConstellationView? _constellationView;
    private bool _seederRunning = true;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var status = await Api.GetSeederStatusAsync();
            _seederRunning = status?.IsRunning ?? true;

            await ReloadFromApi();

            Hub.StatusUpdated += OnStatusUpdated;
            Hub.DeviceRemoved += OnDeviceRemoved;
            Hub.AllDevicesCleared += OnAllDevicesCleared;
            Hub.Reconnected += OnReconnected;
            await Hub.EnsureStartedAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing: {ex.Message}");
        }
    }

    private void OnStatusUpdated(DeviceStatus status)
    {
        try
        {
            _statusByDevice[status.DeviceId] = status;
            if (status.Severity is AnomalySeverity.Anomalous or AnomalySeverity.Elevated or AnomalySeverity.Disconnected)
            {
                _alertEvents.Add(new AlertTimeline.AlertEvent(status.DeviceId, status.Severity, status.LastSeen));
                if (_alertEvents.Count > MaxAlertEvents)
                {
                    _alertEvents.RemoveAt(0);
                }
            }
            Recompute();
            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in OnStatusUpdated: {ex.Message}");
        }
    }

    // Fired when any client (including this one) removes a single device via
    // the API. Every connected dashboard applies it, so a device removed on
    // one screen actually disappears everywhere.
    private void OnDeviceRemoved(string deviceId)
    {
        _statusByDevice.Remove(deviceId);
        _alertEvents.RemoveAll(e => e.DeviceId == deviceId);
        if (_selected?.DeviceId == deviceId)
        {
            _selected = null;
        }
        Recompute();
        InvokeAsync(StateHasChanged);
    }

    // Fired when any client clears the whole registry. This is the broadcast
    // that makes "clear all" actually stick everywhere instead of just on
    // the screen that clicked the button.
    private void OnAllDevicesCleared()
    {
        _statusByDevice.Clear();
        _alertEvents.Clear();
        _selected = null;
        Recompute();
        InvokeAsync(StateHasChanged);
    }

    // If the SignalR connection drops and reconnects, we may have missed a
    // remove/clear/update broadcast while offline. Re-pulling the full list
    // from the API is the safe way to guarantee we end up in sync with the
    // server rather than possibly stuck showing stale nodes.
    private async void OnReconnected()
    {
        await ReloadFromApi();
        await InvokeAsync(StateHasChanged);
    }

    private void Recompute()
    {
        try
        {
            _devices = _statusByDevice.Values.ToList();
            _activeSensors = _devices.Count;
            _anomalyCount = _devices.Count(d => d.Severity == AnomalySeverity.Anomalous);
            _disconnectedCount = _devices.Count(d => d.Severity == AnomalySeverity.Disconnected);
            _throughputPerMinute = _devices.Sum(d => d.ThroughputLastMinute);
            _zoneSummaries = _devices
                .GroupBy(d => d.ZoneName)
                .Select(g => new ZoneList.ZoneSummary(g.Key, g.Max(d => d.Severity)))
                .OrderBy(z => z.Name)
                .ToList();
            if (_selected is not null && _statusByDevice.TryGetValue(_selected.DeviceId, out var refreshed))
            {
                _selected = refreshed;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in Recompute: {ex.Message}");
        }
    }

    private void OnDeviceSelected(DeviceStatus device) => _selected = device;
    
    private void OnZoneClicked(string zoneName) => _highlightZone = _highlightZone == zoneName ? null : zoneName;

    private async Task OnDeviceRegistered(DeviceStatus newDevice)
    {
        try
        {
            _showRegistrationForm = false;
            _statusByDevice[newDevice.DeviceId] = newDevice;
            Recompute();
            StateHasChanged();
            
            if (_constellationView is not null)
            {
                await Task.Delay(100);
                _constellationView.TriggerSpawnForDevice(newDevice.DeviceId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in OnDeviceRegistered: {ex.Message}");
        }
    }

    // Reload from API manually - and also used internally to (re)sync state,
    // since it's the single source of truth for "what devices exist".
    private async Task ReloadFromApi()
    {
        try
        {
            var devices = await Api.GetAllStatusesAsync();
            _statusByDevice.Clear();
            foreach (var device in devices)
            {
                _statusByDevice[device.DeviceId] = device;
            }
            Recompute();
            StateHasChanged();
            Console.WriteLine($"Loaded {devices.Count} devices from API");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reloading from API: {ex.Message}");
        }
    }

    // Start the seeder
    private async Task StartSeeder()
    {
        _busy = true;
        try
        {
            var started = await Api.StartSeederAsync();
            if (started)
            {
                _seederRunning = true;
            }
            else
            {
                Console.WriteLine("Failed to start seeder");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error starting seeder: {ex.Message}");
        }
        finally
        {
            _busy = false;
        }
    }

    // Stop the seeder (devices already registered keep their last-known
    // status; no telemetry updates arrive until it's started again).
    private async Task StopSeeder()
    {
        _busy = true;
        try
        {
            var stopped = await Api.StopSeederAsync();
            if (stopped)
            {
                _seederRunning = false;
            }
            else
            {
                Console.WriteLine("Failed to stop seeder");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error stopping seeder: {ex.Message}");
        }
        finally
        {
            _busy = false;
        }
    }

    // Clears every device from the *server-side* registry (tree, baselines,
    // latest status, batchers, throughput counters) and only then clears the
    // local cache. Doing it in this order - server first - is what actually
    // fixes "clearing all simulated nodes": previously this button only ever
    // touched the client's local dictionary, so the API kept reporting every
    // "cleared" device and they came straight back on the next reload or
    // telemetry tick.
    private async Task ClearAllDevices()
    {
        _busy = true;
        try
        {
            var cleared = await Api.ClearAllDevicesAsync();
            if (!cleared)
            {
                Console.WriteLine("Failed to clear devices on the server; local state left untouched.");
                return;
            }

            // The server also broadcasts "AllDevicesCleared" to every
            // connected dashboard (including this one) over SignalR, but we
            // apply it immediately here too so the UI doesn't wait a round
            // trip before it looks cleared.
            OnAllDevicesCleared();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error clearing devices: {ex.Message}");
        }
        finally
        {
            _busy = false;
        }
    }

    // Removes a single device from the server-side registry, used from the
    // detail panel's "Remove device" action.
    private async Task RemoveDevice(string deviceId)
    {
        _busy = true;
        try
        {
            var removed = await Api.RemoveDeviceAsync(deviceId);
            if (!removed)
            {
                Console.WriteLine($"Failed to remove device '{deviceId}' on the server.");
                return;
            }

            OnDeviceRemoved(deviceId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error removing device: {ex.Message}");
        }
        finally
        {
            _busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            Hub.StatusUpdated -= OnStatusUpdated;
            Hub.DeviceRemoved -= OnDeviceRemoved;
            Hub.AllDevicesCleared -= OnAllDevicesCleared;
            Hub.Reconnected -= OnReconnected;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in Dispose: {ex.Message}");
        }
        await ValueTask.CompletedTask;
    }
}