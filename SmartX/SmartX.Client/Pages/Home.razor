@page "/"

<div class="landing">
    <header class="landing-header">
        <span class="logo-mark">◈</span>
        <h1>Smart-X Gateway</h1>
        <p>Hybrid IoT mesh ecosystem: Portfolio of Evidence, Part 1</p>
    </header>

    <div class="pillar-grid">
        <a class="pillar-card pillar-active" href="/ingestion">
            <span class="pillar-icon">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="2.4" fill="currentColor" />
                    <circle cx="5" cy="6" r="1.6" fill="currentColor" opacity="0.7" />
                    <circle cx="19" cy="6" r="1.6" fill="currentColor" opacity="0.7" />
                    <circle cx="5" cy="18" r="1.6" fill="currentColor" opacity="0.7" />
                    <circle cx="19" cy="18" r="1.6" fill="currentColor" opacity="0.7" />
                    <line x1="12" y1="12" x2="5" y2="6" stroke="currentColor" stroke-width="1" opacity="0.5" />
                    <line x1="12" y1="12" x2="19" y2="6" stroke="currentColor" stroke-width="1" opacity="0.5" />
                    <line x1="12" y1="12" x2="5" y2="18" stroke="currentColor" stroke-width="1" opacity="0.5" />
                    <line x1="12" y1="12" x2="19" y2="18" stroke="currentColor" stroke-width="1" opacity="0.5" />
                </svg>
            </span>
            <h2>Sensor Data Ingestion &amp; Telemetry</h2>
            <p>Live ingestion, validation, and the Anomaly Constellation dashboard.</p>
            <span class="pillar-cta">Open dashboard →</span>
        </a>

        <div class="pillar-card pillar-disabled">
            <span class="pillar-icon">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 5h16v10H9l-4 4V5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                </svg>
            </span>
            <h2>Real-Time Command Stream &amp; History</h2>
            <p>Disabled, to be implemented in Part 2.</p>
        </div>

        <div class="pillar-card pillar-disabled">
            <span class="pillar-icon">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="5" r="1.8" stroke="currentColor" stroke-width="1.4" />
                    <circle cx="5" cy="19" r="1.8" stroke="currentColor" stroke-width="1.4" />
                    <circle cx="19" cy="19" r="1.8" stroke="currentColor" stroke-width="1.4" />
                    <line x1="12" y1="6.8" x2="5" y2="17.2" stroke="currentColor" stroke-width="1.2" />
                    <line x1="12" y1="6.8" x2="19" y2="17.2" stroke="currentColor" stroke-width="1.2" />
                    <line x1="6.8" y1="19" x2="17.2" y2="19" stroke="currentColor" stroke-width="1.2" />
                </svg>
            </span>
            <h2>Network Topology &amp; Mesh Routing</h2>
            <p>Disabled, to be implemented in the final PoE.</p>
        </div>
    </div>
</div>
