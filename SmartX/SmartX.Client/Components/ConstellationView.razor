@using System.Globalization

@{
    var visibleDevices = FilteredDevices;
    var layout = BuildLayout(visibleDevices);
    var total = visibleDevices.Count;
}

<div class="cx-wrap">
    <svg viewBox="0 0 800 520" class="cx-svg @(total > 28 ? "cx-dense" : "")" role="img" aria-label="Anomaly constellation of all registered devices">
        <defs>
            <radialGradient id="cxGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#1d3146" stop-opacity="0.95" />
                <stop offset="100%" stop-color="#070b10" stop-opacity="0" />
            </radialGradient>
            <linearGradient id="cxSweep" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#33f0b0" stop-opacity="0" />
                <stop offset="100%" stop-color="#33f0b0" stop-opacity="0.30" />
            </linearGradient>
        </defs>

        <circle cx="400" cy="260" r="245" fill="url(#cxGlow)" />

        @foreach (var zone in layout.Zones)
        {
            <path d="@ArcPath(zone.Start, zone.End, 62, 228)"
                  class="cx-zone cx-zone-@(zone.Index % 6)" />
        }

        <circle cx="400" cy="260" r="62" class="cx-ring" />
        <circle cx="400" cy="260" r="105" class="cx-ring" />
        <circle cx="400" cy="260" r="150" class="cx-ring" />
        <circle cx="400" cy="260" r="195" class="cx-ring" />
        <circle cx="400" cy="260" r="228" class="cx-ring cx-ring-outer" />

        @for (var i = 0; i < 12; i++)
        {
            var rad = i * 30.0 * Math.PI / 180.0;
            <line x1="@F(400 + 62 * Math.Cos(rad))" y1="@F(260 + 62 * Math.Sin(rad))"
                  x2="@F(400 + 228 * Math.Cos(rad))" y2="@F(260 + 228 * Math.Sin(rad))" class="cx-spoke" />
        }

        <g class="cx-sweep">
            <path d="M400,260 L628,260 A228,228 0 0 1 586.8,390.8 Z" fill="url(#cxSweep)" />
            <line x1="400" y1="260" x2="628" y2="260" class="cx-sweep-edge" />
        </g>

        @foreach (var zone in layout.Zones)
        {
            var mid = (zone.Start + zone.End) / 2;
            <g class="cx-zone-label-group">
                <text x="@F(400 + 242 * Math.Cos(mid))" y="@F(260 + 242 * Math.Sin(mid) + 4)"
                      text-anchor="@AnchorFor(mid)" class="cx-zone-label">@Trunc(zone.Name) (@zone.Count)</text>
            </g>
        }

        @foreach (var placed in layout.Nodes)
        {
            <line x1="400" y1="260" x2="@F(placed.X)" y2="@F(placed.Y)"
                  class="cx-edge cx-edge-@SeverityName(placed.Device.Severity) @(IsDimmed(placed.Device) ? "cx-dim" : "")" />
        }

        @foreach (var placed in layout.Nodes)
        {
            var device = placed.Device;
            var radius = NodeRadius(device.Severity);
            var isSelected = device.DeviceId == SelectedDeviceId;

            <g class="cx-node cx-node-@SeverityName(device.Severity) @(IsSeverityHidden(device) ? "cx-dim" : "") @(isSelected ? "cx-selected" : "") @(_spawnIds.Contains(device.DeviceId) ? "cx-spawn" : "")"
               @key="device.DeviceId"
               tabindex="0"
               role="button"
               aria-label="@AriaFor(device)"
               @onclick="() => OnDeviceSelected.InvokeAsync(device)"
               @onkeydown="e => OnNodeKeyDown(e, device)">

                @if (device.Severity == AnomalySeverity.Anomalous)
                {
                    <circle cx="@F(placed.X)" cy="@F(placed.Y)" r="@radius" class="cx-pulse" />
                    <circle cx="@F(placed.X)" cy="@F(placed.Y)" r="@radius" class="cx-pulse cx-pulse-2" />
                }
                @if (isSelected)
                {
                    <circle cx="@F(placed.X)" cy="@F(placed.Y)" r="@(radius + 9)" class="cx-lock" />
                }

                <circle cx="@F(placed.X)" cy="@F(placed.Y)" r="@(radius + 12)" class="cx-hit" />
                <circle cx="@F(placed.X)" cy="@F(placed.Y)" r="@radius" class="cx-dot">
                    <title>@device.DeviceId (@device.ZoneName): @F(device.LastValue), @device.Severity</title>
                </circle>

                <g class="cx-label-group">
                    <text x="@F(placed.X)" y="@F(placed.Y - radius - 7)"
                          class="cx-label @(LabelAlwaysVisible(device, isSelected) ? "" : "cx-label-hover")">@ShortId(device.DeviceId)</text>
                </g>

                @if (isSelected || device.Severity != AnomalySeverity.Healthy)
                {
                    <g class="cx-value-group">
                        <text x="@F(placed.X)" y="@F(placed.Y + radius + 15)"
                              class="cx-label cx-value cx-value-@SeverityName(device.Severity)">@F(device.LastValue)</text>
                    </g>
                }
            </g>
        }

        <circle cx="400" cy="260" r="64" fill="url(#cxGlow)" />

        @foreach (var segment in HealthSegments())
        {
            <circle cx="400" cy="260" r="40" transform="rotate(-90 400 260)"
                    class="cx-donut cx-donut-@segment.Css"
                    stroke-dasharray="@segment.Dash" stroke-dashoffset="@segment.Offset" />
        }

        <circle cx="400" cy="260" r="31" class="cx-hub" />
        <text x="400" y="258" class="cx-hub-label">GATEWAY</text>
        <text x="400" y="272" class="cx-hub-sub">@total nodes</text>

        @if (total == 0)
        {
            <g class="cx-empty">
                <text x="400" y="340" class="cx-empty-text">AWAITING SIGNAL</text>
            </g>
        }
    </svg>

    <div class="cx-legend" role="group" aria-label="Filter by status">
        @foreach (var severity in SeverityOrder)
        {
            <button type="button"
                    class="cx-pill cx-pill-@SeverityName(severity) @(HiddenSeverities.Contains(severity) ? "cx-pill-off" : "")"
                    aria-pressed="@(HiddenSeverities.Contains(severity) ? "false" : "true")"
                    @onclick="() => ToggleSeverity(severity)">
                <i></i>@severity <b>@CountOf(severity)</b>
            </button>
        }
        <button type="button" class="cx-reset" @onclick="ResetFilters">Reset filters</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<DeviceStatus> Devices { get; set; } = [];
    [Parameter] public EventCallback<DeviceStatus> OnDeviceSelected { get; set; }
    [Parameter] public string? SelectedDeviceId { get; set; }
    [Parameter] public string? HighlightZone { get; set; }
    [Parameter, EditorRequired] public IReadOnlySet<AnomalySeverity> HiddenSeverities { get; set; } = new HashSet<AnomalySeverity>();
    [Parameter] public EventCallback<AnomalySeverity> OnSeverityToggled { get; set; }
    [Parameter] public EventCallback OnResetFilters { get; set; }
    [Parameter] public bool ForceSpawnAll { get; set; }

    private static readonly AnomalySeverity[] SeverityOrder =
    [
        AnomalySeverity.Healthy,
        AnomalySeverity.Elevated,
        AnomalySeverity.Anomalous,
        AnomalySeverity.Disconnected
    ];

    private static readonly double[] Rings = [100, 145, 190];

    private readonly HashSet<string> _knownDeviceIds = [];
    private HashSet<string> _spawnIds = [];
    private List<DeviceStatus> FilteredDevices => HighlightZone is null
        ? Devices
        : Devices.Where(device => IsSameZone(device.ZoneName, HighlightZone)).ToList();

    protected override void OnParametersSet()
    {
        var currentIds = Devices.Select(d => d.DeviceId).ToHashSet();

        if (ForceSpawnAll)
        {
            _spawnIds = currentIds.ToHashSet();
            _knownDeviceIds.Clear();
            _knownDeviceIds.UnionWith(currentIds);
            ForceSpawnAll = false;
        }
        else
        {
            _spawnIds = currentIds.Except(_knownDeviceIds).ToHashSet();
            _knownDeviceIds.UnionWith(currentIds);
        }
    }

    // Public API kept from Part 1: the Ingestion page calls these after registering devices.
    public void TriggerSpawnForAll()
    {
        _spawnIds = Devices.Select(d => d.DeviceId).ToHashSet();
        _knownDeviceIds.Clear();
        _knownDeviceIds.UnionWith(_spawnIds);
        StateHasChanged();
    }

    public void TriggerSpawnForDevice(string deviceId)
    {
        if (Devices.Any(d => d.DeviceId == deviceId))
        {
            _spawnIds.Add(deviceId);
            _knownDeviceIds.Remove(deviceId);
            _knownDeviceIds.Add(deviceId);
            StateHasChanged();
        }
    }

    // ----- layout: one angular sector per zone, devices spread across three rings so labels never collide -----

    private LayoutResult BuildLayout(IReadOnlyList<DeviceStatus> devices)
    {
        var zones = new List<ZoneSector>();
        var nodes = new List<PlacedNode>();
        var total = devices.Count;
        if (total == 0)
        {
            return new LayoutResult(zones, nodes);
        }

        var groups = devices
            .GroupBy(d => d.ZoneName)
            .OrderBy(g => g.Key, StringComparer.Ordinal)
            .ToList();

        var gap = groups.Count > 1 ? 0.05 : 0.0;
        var usable = 2 * Math.PI - gap * groups.Count;
        var cursor = -Math.PI / 2;

        for (var zoneIndex = 0; zoneIndex < groups.Count; zoneIndex++)
        {
            var members = groups[zoneIndex].OrderBy(d => d.DeviceId, StringComparer.Ordinal).ToList();
            var span = groups.Count == 1 ? 2 * Math.PI - 0.03 : usable * members.Count / total;
            var start = cursor + gap / 2;
            var end = start + span;
            zones.Add(new ZoneSector(groups[zoneIndex].Key, start, end, zoneIndex, members.Count));

            var pad = Math.Min(0.06, span * 0.2);
            for (var j = 0; j < members.Count; j++)
            {
                var t = (j + 0.5) / members.Count;
                var angle = start + pad + t * (span - 2 * pad);
                var ring = Rings[(j + zoneIndex) % Rings.Length];
                nodes.Add(new PlacedNode(members[j], 400 + ring * Math.Cos(angle), 260 + ring * Math.Sin(angle)));
            }

            cursor += span + gap;
        }

        return new LayoutResult(zones, nodes);
    }

    private static string ArcPath(double startAngle, double endAngle, double innerRadius, double outerRadius)
    {
        var large = endAngle - startAngle > Math.PI ? 1 : 0;
        var (x0, y0) = Point(outerRadius, startAngle);
        var (x1, y1) = Point(outerRadius, endAngle);
        var (x2, y2) = Point(innerRadius, endAngle);
        var (x3, y3) = Point(innerRadius, startAngle);

        return $"M{F(x0)},{F(y0)} A{F(outerRadius)},{F(outerRadius)} 0 {large} 1 {F(x1)},{F(y1)} " +
               $"L{F(x2)},{F(y2)} A{F(innerRadius)},{F(innerRadius)} 0 {large} 0 {F(x3)},{F(y3)} Z";
    }

    private static (double X, double Y) Point(double radius, double angle) =>
        (400 + radius * Math.Cos(angle), 260 + radius * Math.Sin(angle));

    // ----- health donut around the gateway -----

    private List<DonutSegment> HealthSegments()
    {
        var segments = new List<DonutSegment>();
        var total = FilteredDevices.Count;
        if (total == 0)
        {
            return segments;
        }

        const double circumference = 2 * Math.PI * 40;
        double used = 0;

        foreach (var severity in SeverityOrder)
        {
            var count = CountOf(severity);
            if (count == 0)
            {
                continue;
            }

            var length = circumference * count / total;
            var visible = Math.Max(0.5, length - (length > 6 ? 2 : 0));
            segments.Add(new DonutSegment(
                SeverityName(severity),
                $"{F(visible)} {F(circumference)}",
                F(-used)));
            used += length;
        }

        return segments;
    }

    private int CountOf(AnomalySeverity severity) => FilteredDevices.Count(d => d.Severity == severity);

    // ----- filtering -----

    private bool IsDimmed(DeviceStatus device) => HiddenSeverities.Contains(device.Severity);

    private bool IsSeverityHidden(DeviceStatus device) =>
        HiddenSeverities.Contains(device.Severity);

    private static bool IsSameZone(string left, string right) =>
        string.Equals(left.Trim(), right.Trim(), StringComparison.OrdinalIgnoreCase);

    // Guarded: refuses to hide the last remaining visible severity.
    private Task ToggleSeverity(AnomalySeverity severity) =>
        OnSeverityToggled.InvokeAsync(severity);

    private async Task ResetFilters()
    {
        await OnResetFilters.InvokeAsync();
    }

    private async Task OnNodeKeyDown(KeyboardEventArgs e, DeviceStatus device)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            await OnDeviceSelected.InvokeAsync(device);
        }
    }

    // ----- small helpers -----

    private static bool LabelAlwaysVisible(DeviceStatus device, bool isSelected) =>
        isSelected || device.Severity != AnomalySeverity.Healthy;

    private static int NodeRadius(AnomalySeverity severity) => severity switch
    {
        AnomalySeverity.Anomalous => 12,
        AnomalySeverity.Elevated => 10,
        _ => 9
    };

    private static string ShortId(string deviceId)
    {
        var cut = deviceId.LastIndexOf('-');
        return cut >= 0 && cut < deviceId.Length - 1 ? deviceId[(cut + 1)..] : deviceId;
    }

    private static string Trunc(string text) => text.Length > 24 ? text[..23] + "..." : text;

    private static string AnchorFor(double angle)
    {
        var cos = Math.Cos(angle);
        return cos > 0.3 ? "start" : cos < -0.3 ? "end" : "middle";
    }

    private static string AriaFor(DeviceStatus device) =>
        $"{device.DeviceId}, {device.Severity}, value {F(device.LastValue)}";

    private static string SeverityName(AnomalySeverity severity) => severity.ToString().ToLowerInvariant();

    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private sealed record ZoneSector(string Name, double Start, double End, int Index, int Count);
    private sealed record PlacedNode(DeviceStatus Device, double X, double Y);
    private sealed record LayoutResult(List<ZoneSector> Zones, List<PlacedNode> Nodes);
    private sealed record DonutSegment(string Css, string Dash, string Offset);
}
