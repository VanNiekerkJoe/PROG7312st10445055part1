<div class="panel detail-panel">
    <p class="panel-title">Selected node</p>

    @if (Selected is null)
    {
        <p class="detail-empty">Click a node in the constellation to inspect it.</p>
    }
    else
    {
        <div class="detail-header-row">
            <h3>@Selected.DeviceId</h3>
            @if (OnRemoveDevice.HasDelegate)
            {
                <button class="detail-remove-btn" title="Remove this device" @onclick="() => OnRemoveDevice.InvokeAsync(Selected.DeviceId)">
                    🗑 Remove
                </button>
            }
        </div>
        <p class="detail-severity @SeverityClass(Selected.Severity)">@Selected.Severity</p>

        <table class="detail-table">
            <tbody>
                <tr><td>Zone</td><td>@Selected.ZoneName</td></tr>
                <tr><td>Category</td><td>@Selected.Category</td></tr>
                <tr><td>Reading</td><td>@Selected.LastValue.ToString("0.##")</td></tr>
                <tr><td>z-score</td><td class="@SeverityClass(Selected.Severity)">@Selected.ZScore.ToString("0.##")</td></tr>
                <tr><td>Throughput</td><td>@Selected.ThroughputLastMinute /min</td></tr>
            </tbody>
        </table>

        <div class="attachment-section" @key="Selected.DeviceId">
            <label class="attachment-input">
                Attach config / log / photo
                <InputFile OnChange="OnFileSelected" />
            </label>
            @if (_uploading)
            {
                <p class="upload-status"><span class="spinner spinner-inline"></span> Uploading…</p>
            }
            else if (!string.IsNullOrEmpty(_uploadError))
            {
                <p class="upload-status upload-error">@_uploadError</p>
            }
            else if (_loadingAttachments)
            {
                <p class="upload-status"><span class="spinner spinner-inline"></span> Loading attachments…</p>
            }

            @if (_attachments.Count > 0)
            {
                <ul class="attachment-list">
                    @foreach (var name in _attachments)
                    {
                        <li>
                            📎 <a href="@ApiClient?.GetAttachmentUrl(Selected.DeviceId, name)" target="_blank" rel="noopener">@name</a>
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>

@code {
    [Parameter] public DeviceStatus? Selected { get; set; }
    [Parameter] public TelemetryApiClient? ApiClient { get; set; }
    [Parameter] public EventCallback<string> OnRemoveDevice { get; set; }

    private bool _uploading;
    private bool _loadingAttachments;
    private string? _uploadError;
    private string? _lastDeviceId;
    private readonly List<string> _attachments = [];

    protected override async Task OnParametersSetAsync()
    {
        // Reload attachments from the server whenever the selection changes
        // to a different device, instead of relying on a session-local list
        // that forgets everything uploaded before the current page load.
        if (Selected?.DeviceId != _lastDeviceId)
        {
            _lastDeviceId = Selected?.DeviceId;
            _attachments.Clear();
            _uploadError = null;

            if (Selected is not null && ApiClient is not null)
            {
                _loadingAttachments = true;
                StateHasChanged();
                var attachments = await ApiClient.GetAttachmentsAsync(Selected.DeviceId);
                // Selection may have changed again while this await was in
                // flight; only apply the result if it's still current.
                if (Selected?.DeviceId == _lastDeviceId)
                {
                    _attachments.AddRange(attachments);
                }
                _loadingAttachments = false;
            }
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        if (Selected is null || ApiClient is null) return;

        _uploading = true;
        _uploadError = null;
        StateHasChanged();

        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var ok = await ApiClient.UploadAttachmentAsync(Selected.DeviceId, stream, e.File.Name);
            if (ok)
            {
                _attachments.Add(e.File.Name);
            }
            else
            {
                _uploadError = "Upload failed, please try again.";
            }
        }
        catch (Exception)
        {
            _uploadError = "Upload failed, please try again.";
        }
        finally
        {
            _uploading = false;
        }
    }

    private static string SeverityClass(AnomalySeverity severity) => severity switch
    {
        AnomalySeverity.Healthy => "sev-healthy",
        AnomalySeverity.Elevated => "sev-elevated",
        AnomalySeverity.Anomalous => "sev-anomalous",
        AnomalySeverity.Disconnected => "sev-disconnected",
        _ => ""
    };
}